<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- HEADER FIXO -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- BTN CLOSE -->
        <Button
            android:id="@+id/btn_close"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:backgroundTint="@android:color/transparent"
            android:drawableTop="@drawable/ic_x"
            android:drawableTint="@color/text_primary"
            android:contentDescription="Close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- BTN HELP -->
        <Button
            android:id="@+id/btn_help"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:backgroundTint="@android:color/transparent"
            android:drawableTop="@drawable/ic_help"
            android:drawableTint="@color/text_primary"
            android:contentDescription="Help"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="30dp">

            <!-- TITLE PIX AREA -->
            <TextView
                android:id="@+id/text_area_pix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/areapix"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <!-- INPUT KEY PIX-->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_pix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_purple"
                android:hint="@string/text_input_area_pix"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_send"
                app:endIconContentDescription="enviar"
                app:boxBackgroundMode="filled"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@color/purple_500"
                app:hintTextColor="@color/purple_500">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_pix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:padding="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/gray_500"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- SERVIÇOS -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp">

                <!-- GUIDELINES -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.16"/>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.50"/>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.84"/>

                <!-- TRANSFER -->
                <ImageView
                    android:id="@+id/img_transfer_pix"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/ic_circle_gray"
                    android:padding="12dp"
                    android:src="@drawable/ic_transfer"
                    android:clickable="true"
                    android:contentDescription="transfer pix"
                    app:layout_constraintStart_toStartOf="@id/guideline1"
                    app:layout_constraintEnd_toEndOf="@id/guideline1"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/text_transfer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Transferir"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/img_transfer_pix"
                    app:layout_constraintStart_toStartOf="@id/img_transfer_pix"
                    app:layout_constraintEnd_toEndOf="@id/img_transfer_pix"/>

                <!-- CREDIT PIX -->
                <ImageView
                    android:id="@+id/img_view_credit_pix"
                    android:layout_width="44dp"
                    android:layout_height="46dp"
                    android:background="@drawable/ic_circle_gray"
                    android:contentDescription="credit_pix"
                    android:padding="12dp"
                    android:src="@drawable/ic_credit_pix"
                    app:layout_constraintEnd_toEndOf="@id/guideline2"
                    app:layout_constraintStart_toStartOf="@id/guideline2"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/text_credit_pix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pix no \n crédito"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/img_view_credit_pix"
                    app:layout_constraintStart_toStartOf="@id/img_view_credit_pix"
                    app:layout_constraintEnd_toEndOf="@id/img_view_credit_pix"/>

                <!-- CODE QR -->
                <ImageView
                    android:id="@+id/img_view_codeQR"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/ic_circle_gray"
                    android:contentDescription="code_qr"
                    android:padding="12dp"
                    android:src="@drawable/ic_qr_code"
                    app:layout_constraintStart_toStartOf="@id/guideline3"
                    app:layout_constraintEnd_toEndOf="@id/guideline3"
                    app:layout_constraintTop_toTopOf="parent"/>

                <!-- Pix copy and paste -->

                <TextView
                    android:id="@+id/text_QR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Ler QR\n code"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@id/img_view_codeQR"
                    app:layout_constraintHorizontal_bias="0.294"
                    app:layout_constraintStart_toStartOf="@id/img_view_codeQR"
                    app:layout_constraintTop_toBottomOf="@id/img_view_codeQR" />

                <ImageView
                    android:id="@+id/img_view_copy_paste"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="50dp"
                    android:background="@drawable/ic_circle_gray"
                    android:contentDescription="copy_paste"
                    android:padding="12dp"
                    android:src="@drawable/ic_copy_paste"
                    app:layout_constraintTop_toBottomOf="@id/img_transfer_pix"
                    app:layout_constraintStart_toStartOf="@id/guideline1"
                    app:layout_constraintEnd_toEndOf="@id/guideline1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pix copia e\ncola"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/img_view_copy_paste"
                    app:layout_constraintStart_toStartOf="@id/img_view_copy_paste"
                    app:layout_constraintEnd_toEndOf="@id/img_view_copy_paste"/>

                <!-- Cobrar -->
                <ImageView
                    android:id="@+id/img_view_charge"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="50dp"
                    android:background="@drawable/ic_circle_gray"
                    android:contentDescription="charge"
                    android:padding="12dp"
                    android:src="@drawable/ic_charge"
                    app:layout_constraintTop_toBottomOf="@id/img_view_credit_pix"
                    app:layout_constraintStart_toStartOf="@id/guideline2"
                    app:layout_constraintEnd_toEndOf="@id/guideline2"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Cobrar"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/img_view_charge"
                    app:layout_constraintStart_toStartOf="@id/img_view_charge"
                    app:layout_constraintEnd_toEndOf="@id/img_view_charge"/>

                <!-- Pix WhatsApp -->
                <ImageView
                    android:id="@+id/img_view_whatsapp"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="50dp"
                    android:background="@drawable/ic_circle_gray"
                    android:contentDescription="whatsapp"
                    android:padding="12dp"
                    android:src="@drawable/ic_whatsap"
                    app:layout_constraintTop_toBottomOf="@id/img_view_codeQR"
                    app:layout_constraintStart_toStartOf="@id/guideline3"
                    app:layout_constraintEnd_toEndOf="@id/guideline3"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="pix no \nWhatsApp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/img_view_whatsapp"
                    app:layout_constraintStart_toStartOf="@id/img_view_whatsapp"
                    app:layout_constraintEnd_toEndOf="@id/img_view_whatsapp"/>

                <ImageView
                    android:id="@+id/img_view_pix_voice"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="45dp"
                    android:background="@drawable/ic_circle_gray"
                    android:contentDescription="whatsapp"
                    android:padding="12dp"
                    android:src="@drawable/ic_pix_voice"
                    app:layout_constraintTop_toBottomOf="@id/img_view_copy_paste"
                    app:layout_constraintStart_toStartOf="@id/img_view_copy_paste"
                    app:layout_constraintEnd_toEndOf="@id/img_view_copy_paste"/>
                <!--pix for voice-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="pix por \npvoz"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/img_view_pix_voice"
                    app:layout_constraintStart_toStartOf="@id/img_view_pix_voice"
                    app:layout_constraintEnd_toEndOf="@id/img_view_pix_voice"/>
                <!--DEPOSIT-->
                <ImageView
                    android:id="@+id/img_view_deposit"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="45dp"
                    android:background="@drawable/ic_circle_gray"
                    android:contentDescription="whatsapp"
                    android:padding="12dp"
                    android:src="@drawable/ic_deposit"
                    app:layout_constraintTop_toBottomOf="@id/img_view_charge"
                    app:layout_constraintStart_toStartOf="@id/img_view_charge"
                    app:layout_constraintEnd_toEndOf="@id/img_view_charge"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Depositar"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/img_view_deposit"
                    app:layout_constraintStart_toStartOf="@id/img_view_deposit"
                    app:layout_constraintEnd_toEndOf="@id/img_view_deposit"/>


                <ImageView
                    android:id="@+id/img_contactless_payment"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="45dp"
                    android:background="@drawable/ic_circle_gray"
                    android:contentDescription="whatsapp"
                    android:padding="12dp"
                    android:src="@drawable/ic_contactless_payment"
                    app:layout_constraintTop_toBottomOf="@id/img_view_whatsapp"
                    app:layout_constraintStart_toStartOf="@id/img_view_whatsapp"
                    app:layout_constraintEnd_toEndOf="@id/img_view_whatsapp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pagamento ppr\naproximação"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/img_contactless_payment"
                    app:layout_constraintStart_toStartOf="@id/img_contactless_payment"
                    app:layout_constraintEnd_toEndOf="@id/img_contactless_payment"/>
















            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>