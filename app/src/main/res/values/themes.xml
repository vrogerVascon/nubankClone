<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NubankClone" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary colors -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorOnPrimary">@color/text_light</item>

        <item name="colorPrimaryContainer">@color/purple_700</item>
        <item name="colorOnPrimaryContainer">@color/text_light</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/purple_700</item>
        <item name="colorOnSecondary">@color/text_light</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/purple_700</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation -->
        <item name="android:navigationBarColor">@color/background</item>

        <!-- Buttons -->
        <item name="materialButtonStyle">@style/Widget.NubankClone.Button</item>

    </style>

    <!-- Default style -->
    <style name="Widget.NubankClone.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/purple_500</item>
        <item name="android:textColor">@color/text_light</item>
        <item name="cornerRadius">16dp</item>
    </style>

</resources>